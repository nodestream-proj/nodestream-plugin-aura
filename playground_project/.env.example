# Copy this file to `.env`, fill in real values, then `source .env` before
# running nodestream. `.env` itself is gitignored; this example file is not.
#
# OrganizationId is only used by pipelines that list an org's full contents
# (aura_organizations, aura_projects, aura_organization_users,
# aura_organization_invites) -- these need org-level access and will
# 403/404 for a credential that only administers specific projects.
#
# ProjectScopes (in nodestream.yaml, not here -- org/project ids aren't
# secrets, and a variable-length list can't come from one flat env var) is
# what every project-scoped pipeline (aura_project_details, aura_instances,
# aura_project_users, aura_customer_managed_keys,
# aura_graph_analytics_sessions, aura_agents) actually reads. Add one entry
# per project you want to sweep -- one run covers all of them.

export AURA_CLIENT_ID=replace_me
export AURA_CLIENT_SECRET=replace_me
export AURA_ORGANIZATION_ID=replace_me
export AURA_PROJECT_ID=replace_me

# --- neo4j target: where the graph gets written ---
export NEO4J_URI=neo4j+s://replace_me.databases.neo4j.io
export NEO4J_USERNAME=neo4j
export NEO4J_PASSWORD=replace_me
export NEO4J_DATABASE=replace_me
